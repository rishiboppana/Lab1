# Backend/src/booking_service/Dockerfile
FROM node:22-alpine

WORKDIR /app

# Copy package files from Backend root
COPY ../../package*.json ./

# Install dependencies
RUN npm install

# Copy the booking service code
COPY . .

# Copy any shared config/utils from parent Backend if needed
COPY ../config ./config
COPY ../models ./models

EXPOSE 3001

# Start the booking service
CMD ["node", "index.js"]